{
  "name": "rn-template",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:cc": "expo start --clear",
    "dev:off": "expo start --offline",
    "build:web": "expo export --platform web",
    "view": "expo serve",
    "lint": "biome check --fix src",
    "test": "vitest run --coverage",
    "check": "expo-doctor",
    "prepare": "lefthook install",
    "update": "nlx expo@latest install --check && ncu -u && ni",
    "commit": "git add -A && git commit --no-edit",
    "squash": "bun scripts/squash.ts && git commit --no-edit --no-verify"
  },
  "dependencies": {
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@es-proj/utils": "^2.0.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-module-resolver": "^5.0.3",
    "czg": "^1.14.0",
    "expo-doctor": "^1.21.5",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "vitest-native": "^0.13.0"
  }
}
